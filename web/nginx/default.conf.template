# Serves the Angular build and proxies the API on the same origin, so the browser never deals with
# CORS and the app never needs to know where the API lives.

# The real client address: Cloudflare's header when the request came through the tunnel, the
# TCP peer otherwise. The API uses it for per-address rate limiting on sign-in.
map $http_cf_connecting_ip $client_ip {
    default $remote_addr;
    ~.      $http_cf_connecting_ip;
}

server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Re-resolve the upstream name periodically so a redeployed API gets picked up. The resolver
    # is Docker's embedded DNS by default and Fly's internal DNS in infra/fly/web.toml.
    resolver ${DNS_RESOLVER} valid=10s;
    set $api_upstream ${API_UPSTREAM};

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    # Hashed build output: cache forever.
    location ~* \.(?:js|css|svg|ico|woff2?)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # ^~ : these prefixes win over the static-asset regex below, so /scalar/scalar.js reaches the API.
    location ^~ /api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $client_ip;
        proxy_set_header X-Forwarded-For $client_ip;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        client_max_body_size 12m;
    }

    location = /health {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
    }

    location ^~ /health/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
    }

    location ^~ /openapi/ {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
    }

    location ^~ /scalar {
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
    }

    # Everything else is the single-page app.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }
}
